[user]
  name = David Brenneman
  email = db@davidbrenneman.com

[alias]
  st = status
  ci = commit
  br = branch
  co = checkout
  df = diff
  lg = log -p
  l = log --pretty=oneline -n 20 --graph
  s = status -s
  d = diff --patch-with-stat
  p = !"git pull; git submodule foreach git pull origin main"
  c = clone --recursive
  ca = !git add . && git add -u && git commit -a
  go = checkout -B
  dft = difftool

[apply]
  whitespace = fix

[core]
  excludesfile = ~/.config/git/ignore
  whitespace = space-before-tab,indent-with-non-tab,trailing-space
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  true-color = always
  syntax-theme = Catppuccin Macchiato

[merge]
  conflictstyle = zdiff3
  log = true

[diff]
  colorMoved = default
  algorithm = histogram
  tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pull]
  rebase = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[rerere]
  enabled = true

[fetch]
  prune = true

[branch]
  sort = -committerdate

[branch "main"]
  remote = origin
  merge = refs/heads/main

[url "git@github.com:"]
  insteadOf = "gh:"
  insteadOf = "github:"

[url "git@gist.github.com:"]
  insteadOf = "gst:"
  insteadOf = "gist:"

[push]
  default = current
  autoSetupRemote = true

[init]
  defaultBranch = main

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

[include]
  path = ~/.gitconfig.local
